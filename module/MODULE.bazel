module(
    name = "v8",
    version = "13.6.233.17",
)

bazel_dep(name = "rules_cc", version = "0.2.16")
bazel_dep(name = "platforms", version = "1.0.0")

# The extension fetches the right per-platform prebuilt V8 at repo-fetch time
# and exposes it as @v8_bin. //:v8 aliases @v8_bin//:v8 so consumers write
# @v8//:v8.
v8_binaries = use_extension("//:extensions.bzl", "v8_binaries")
use_repo(v8_binaries, "v8_bin")
